  {
    "id": "validate/definition-duplicate-name",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %x% = a\n#def %x% = b",
    "note": "A name belongs to one directive, once. The set/def maps flatten a collision to last-wins before anyone can see it, which is why occurrences are tracked. Two #set lines sharing a name are the same error.",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "definition.duplicate-name"
        }
      ]
    }
  },
  {
    "id": "validate/definition-duplicate-name-same-kind",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %x% = a\n#set %x% = b",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "definition.duplicate-name"
        }
      ]
    }
  },
  {
    "id": "validate/include-in-def-value",
    "kind": "deterministic",
    "op": "validate",
    "template": "#def %x% = #include \"y\"\n%x%",
    "note": "Includes resolve after a definition is frozen, so one cannot be rolled into a value.",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "def.include-in-value"
        }
      ]
    }
  },
  {
    "id": "validate/include-in-set-value-is-valid",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %x% = #include \"y\"\n%x%",
    "note": "A macro is substituted verbatim, so its #include reaches the include stage in the body, where it works.",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/plural-count-macro",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %n% = {1|4|9}\n{plural %n%: item|items}",
    "note": "The count is still unresolved spintax when the plural is decided, so the block renders empty. #def is the fix.",
    "locale": "en",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "plural.count-macro"
        }
      ]
    }
  },
  {
    "id": "validate/plural-count-macro-permutation",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %n% = [1|2]\n{plural %n%: item|items}",
    "locale": "en",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "plural.count-macro"
        }
      ]
    }
  },
  {
    "id": "validate/plural-count-macro-chained",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %m% = {1|4|9}\n#set %n% = %m%\n{plural %n%: item|items}",
    "note": "%n% carries no bracket at all: taint propagates through #set references to a fixpoint.",
    "locale": "en",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "plural.count-macro"
        }
      ]
    }
  },
  {
    "id": "validate/plural-count-macro-nested-plural",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %n% = {plural 1:1|2}\n{plural %n%: item|items}",
    "note": "A nested plural resolves in the SAME pass as the outer block, not before it, so the outer count is still spintax when read. Exempting it alongside conditionals was a regression.",
    "locale": "en",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "plural.count-macro"
        }
      ]
    }
  },
  {
    "id": "validate/plural-count-macro-enum-inside-conditional",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %flag% = 1\n#set %n% = {?flag?{1|4}|2}\n{plural %n%: item|items}",
    "note": "The conditional resolves in time; the enumeration it uncovers does not.",
    "locale": "en",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "plural.count-macro"
        }
      ]
    }
  },
  {
    "id": "validate/plural-count-conditional-is-valid",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %flag% = 1\n#set %n% = {?flag?1|2}\n{plural %n%: item|items}",
    "note": "Conditionals resolve BEFORE plurals, so this count IS a literal when it is read. This template renders correctly and must not be flagged.",
    "locale": "en",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/plural-count-def-is-valid",
    "kind": "deterministic",
    "op": "validate",
    "template": "#def %n% = {1|4|9}\n{plural %n%: item|items}",
    "note": "A #def is frozen to literal text before the walk begins, which is what makes it the fix the diagnostic points at.",
    "locale": "en",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/plural-count-literal-set-is-valid",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %n% = 5\n{plural %n%: item|items}",
    "locale": "en",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/set-nonascii-name-is-malformed",
    "note": "Identifier names are ASCII by contract (#56). The line starts with '#set ' but the name is not an identifier, so the malformed-directive check fires — the same template was a VALID, expanding directive to PHP's UCP-widened \\w, i.e. opposite verdicts for one line. render/set-name-nonascii-is-not-a-directive pins the output half.",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %имя% = X",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "set.malformed",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/def-include-boundary-is-ascii",
    "note": "The include-in-a-#def-value check ends its word at any non-ASCII-word character: #includeя still names the directive, so the error fires. PHP's \\b under /u treated я as a word character and the check never matched (#56).",
    "kind": "deterministic",
    "op": "validate",
    "template": "#def %x% = #includeя\n%x%",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "def.include-in-value",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/def-includes-plural-word-is-clean",
    "note": "The negative control for the boundary: 'includes' continues the word with an ASCII letter, so it is NOT the directive and no error fires — the lookahead must not over-reach into plain prose.",
    "kind": "deterministic",
    "op": "validate",
    "template": "#def %x% = #includes\n%x%",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/perm-config-embedded-key-is-flagged",
    "note": "The validator half of perm/config-embedded-key-with-value-is-still-a-sep: 'xminsize=2' looks like key=value to the validator (its test is `\\w+\\s*=`, boundary-free by design), 'xminsize' is not a known key, verdict invalid — while the renderer treats the whole string as a separator. The same family-wide split as the attributes pair, pinned as it ships in all three engines.",
    "kind": "deterministic",
    "op": "validate",
    "template": "[<xminsize=2>a|b]",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "permutation.unknown-key",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/perm-config-html-with-attributes-is-flagged",
    "note": "The family-wide validator/renderer split, pinned AS IT SHIPS in all three engines (spintax-js#58): the renderer's HTML guard accepts attributes and renders this literally (see perm/config-html-with-attributes-renders), but the validator decides config-ness by 'looks like key=value' — class=\"x\" matches, 'class' is not a known key, verdict invalid. Changing either half is a verdict or output change for the whole family and gets its own issue first.",
    "kind": "deterministic",
    "op": "validate",
    "template": "[<li class=\"x\">one</li>|<li>two</li>]",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "permutation.unknown-key",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/include-nbsp-gap-is-not-an-include",
    "note": "The verdict half of the class question: the gap is an escaped U+00A0 NBSP, so the line is plain text, NOT an include with an unknown target — include.unknown-target must not fire. Before the class was spelled out on the PHP side, its UCP-widened whitespace shorthand read this as an include and the engines returned opposite verdicts for the same template (spintax-js#55).",
    "kind": "deterministic",
    "op": "validate",
    "template": "#include\u00a0\"nope\"",
    "knownIncludes": [
      "ok"
    ],
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/directive-check-vt-line-is-text",
    "note": "The malformed-directive check trims ONLY spaces and tabs (/^[ \\t]+/, validator.ts) — a PHP-style ltrim charlist also eats VT/NUL and turns this into set.malformed. After the VT the line is not a directive, so %x% on it is an ordinary undefined REFERENCE (spintax-win's PhpLtrim divergence, fixed 2026-08-07).",
    "kind": "deterministic",
    "op": "validate",
    "template": "\u000b#set %x% = A",
    "expect": {
      "verdict": "valid",
      "diagnostics": [
        {
          "code": "variable.undefined",
          "severity": "warning"
        }
      ]
    }
  },
  {
    "id": "validate/directive-check-nul-line-is-text",
    "note": "Same trim rule, NUL flavour: U+0000 before #set is not trimmed, the line does not start with the directive keyword, nothing is checked, nothing is malformed.",
    "kind": "deterministic",
    "op": "validate",
    "template": "\u0000#set broken",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/directive-check-cr-does-not-split",
    "note": "The check splits the text on LF ALONE. A lone CR is line content, so '#set broken' after it sits mid-line, is never examined as a directive line, and a valid template stays valid. Splitting on five terminators reports set.malformed here.",
    "kind": "deterministic",
    "op": "validate",
    "template": "x\r#set broken",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/directive-check-ls-does-not-split",
    "note": "LF-only split, U+2028 flavour: LINE SEPARATOR does not start a new line for the malformed-directive check either.",
    "kind": "deterministic",
    "op": "validate",
    "template": "x #set broken",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/directive-check-cr-survivor-satisfies",
    "note": "The shape test is DIRECTIVE_RE (/gmu) over the LF-line: under /m a well-formed directive after a CR INSIDE the line anchors and satisfies the test, so the malformed head before the CR is not reported. The render consumes the well-formed half and leaves the head as text — see the render twin in render-semantics.",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set broken\r#set %x% = A\n%x%",
    "expect": {
      "verdict": "valid"
    }
  },
  {
    "id": "validate/definition-last-wins-drops-self-reference",
    "note": "Definitions dedup by name with the LAST one winning (the reference builds a Map and overwrites). The surviving value of %x% is 'B', so the self-reference in the FIRST definition is gone — only the duplicate name is reported. An engine that resolves to the first occurrence invents a self-reference diagnostic here (spintax-win, fixed 2026-08-07).",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %x% = %x%\n#set %x% = B\n%x%",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "definition.duplicate-name",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/definition-last-wins-forms-cycle",
    "note": "The mirror of the case above: the harmless first definition of %a% loses to the second, whose value closes a cycle with %b% — the cycle IS reported. First-wins resolution sees 'plain' and reports nothing, flipping the verdict.",
    "kind": "deterministic",
    "op": "validate",
    "template": "#set %a% = plain\n#set %a% = %b%\n#set %b% = %a%\n%a%",
    "expect": {
      "verdict": "invalid",
      "diagnostics": [
        {
          "code": "definition.duplicate-name",
          "severity": "error"
        },
        {
          "code": "variable.circular-reference",
          "severity": "error"
        }
      ]
    }
  },
  {
    "id": "validate/permutation-key-without-equals-is-not-a-key",
    "note": "MINSIZE_RE/MAXSIZE_RE require the equals sign. 'maxsize 2' with no '=' matches no extractor and raises no unknown-key diagnostic either — the config is just sep, and the template is valid. Treating the '=' as optional runs a maxsize the template never asked for.",
    "kind": "deterministic",
    "op": "validate",
    "template": "[<sep=\"-\" maxsize 2>a|b|c]",
    "expect": {
      "verdict": "valid"
    }
  }
]
