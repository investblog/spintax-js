      "typeVersion": 1,
      "position": [
        660,
        480
      ]
    },
    {
      "parameters": {
        "operation": "validate",
        "template": "={{ $json.text ?? $json.template }}",
        "cleanModelOutput": true,
        "locale": "",
        "spintaxMeta": "={{ $('Build authoring prompt').item.json.spintaxMeta }}"
      },
      "id": "pool-validate1",
      "name": "Validate draft",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        880,
        260
      ]
    },
    {
      "parameters": {
        "operation": "buildRepairPrompt",
        "template": "={{ $json.cleanedTemplate ?? $json.template }}",
        "diagnostics": "={{ $json.diagnostics }}",
        "spintaxMeta": "={{ $('Build authoring prompt').item.json.spintaxMeta }}"
      },
      "id": "pool-repair",
      "name": "Build repair prompt",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        1100,
        620
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userPrompt }}",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $json.systemPrompt }}"
            }
          ]
        }
      },
      "id": "pool-llm2",
      "name": "LLM (repair)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1320,
        620
      ]
    },
    {
      "parameters": {
        "operation": "validate",
        "template": "={{ $json.text ?? $json.template }}",
        "cleanModelOutput": true,
        "locale": "",
        "spintaxMeta": "={{ $('Build authoring prompt').item.json.spintaxMeta }}"
      },
      "id": "pool-validate2",
      "name": "Validate (attempt 2)",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        1540,
        620
      ]
    },
    {
      "parameters": {},
      "id": "pool-giveup",
      "name": "Still invalid - stop (loop is capped)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        800
      ]
    },
    {
      "parameters": {
        "operation": "renderMany",
        "template": "={{ $json.cleanedTemplate }}",
        "count": 12,
        "baseSeed": "pool-2026-08",
        "locale": "en",
        "useIncomingItem": false,
        "fixedVariables": {
          "pair": [
            {
              "name": "product",
              "value": "={{ $('Your brief and product').first().json.product }}",
              "neutralize": false
            },
            {
              "name": "brand",
              "value": "={{ $('Your brief and product').first().json.brand }}",
              "neutralize": false
            },
            {
              "name": "audience",
              "value": "={{ $('Your brief and product').first().json.audience }}",
              "neutralize": false
            },
            {
              "name": "feature",
              "value": "={{ $('Your brief and product').first().json.feature }}",
              "neutralize": false
            }
          ]
        }
      },
      "id": "pool-render",
      "name": "Render 12 variants",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        1760,
        260
      ]
    },
    {
      "parameters": {
        "operation": "lint",
        "lintSource": "text",
        "text": "={{ $json.rendered }}",
        "lintWindow": 6,
        "locale": "en",
        "lintIgnore": "={{ [$('Your brief and product').first().json.product, $('Your brief and product').first().json.brand, $('Your brief and product').first().json.audience, $('Your brief and product').first().json.feature].join('\\n') }}"
      },
      "id": "pool-lint",
      "name": "Lint each variant",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        1980,
        260
      ]
    },
    {
      "parameters": {},
