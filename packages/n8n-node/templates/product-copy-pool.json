{
  "id": "spintax-product-copy-pool",
  "name": "Generate a pool of unique product descriptions from one AI-written spintax template",
  "nodes": [
    {
      "parameters": {},
      "id": "pool-trigger",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pool-brief-value",
              "name": "brief",
              "type": "string",
              "value": "Write a product description (3-4 sentences) for %product% by %brand%, aimed at %audience%. Mention %feature% and end with a concrete reason to buy today. Warm and specific, no superlatives, no exclamation marks. Vary the wording densely, but never let one word appear twice within a sentence: do not define two variables that draw from the same list of synonyms, and keep any two slots that share options far apart."
            },
            {
              "id": "pool-v-product",
              "name": "product",
              "type": "string",
              "value": "Trail Runner 3"
            },
            {
              "id": "pool-v-brand",
              "name": "brand",
              "type": "string",
              "value": "Brightline Gear"
            },
            {
              "id": "pool-v-audience",
              "name": "audience",
              "type": "string",
              "value": "weekend hikers"
            },
            {
              "id": "pool-v-feature",
              "name": "feature",
              "type": "string",
              "value": "a 240 g upper that dries overnight"
            }
          ]
        }
      },
      "id": "pool-brief",
      "name": "Your brief and product",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "operation": "buildAuthoringPrompt",
        "brief": "={{ $json.brief }}",
        "locale": "en",
        "useItemFieldNames": false,
        "allowedVariables": {
          "variable": [
            {
              "name": "product",
              "case": "",
              "note": "the listing title, e.g. Trail Runner 3"
            },
            {
              "name": "brand",
              "case": "",
              "note": "manufacturer name"
            },
            {
              "name": "audience",
              "case": "",
              "note": "who it is for, e.g. weekend hikers"
            },
            {
              "name": "feature",
              "case": "",
              "note": "the one detail worth naming"
            }
          ]
        },
        "channel": "landing",
        "variationLevel": "aggressive"
      },
      "id": "pool-authoring",
      "name": "Build authoring prompt",
      "type": "n8n-nodes-spintax.spintax",
      "typeVersion": 1,
      "position": [
        440,
        260
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userPrompt }}",
        "messages": {
          "messageValues": [
