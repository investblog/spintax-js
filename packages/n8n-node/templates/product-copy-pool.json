              "message": "={{ $json.systemPrompt }}"
            }
          ]
        }
      },
      "id": "pool-llm",
      "name": "Your LLM",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        660,
        260
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "pool-model",
      "name": "OpenAI Chat Model",
