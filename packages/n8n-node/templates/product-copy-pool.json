            {
              "name": "brand",
              "case": "",
              "note": "manufacturer name"
            },
            {
              "name": "audience",
              "case": "",
              "note": "who it is for, e.g. weekend hikers"
            },
            {
              "name": "feature",
              "case": "",
              "note": "the one detail worth naming"
            }
          ]
