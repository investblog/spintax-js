        "assignments": {
          "assignments": [
            {
              "id": "pool-brief-value",
              "name": "brief",
              "type": "string",
              "value": "Write a product description (3-4 sentences) for %product% by %brand%, aimed at %audience%. Mention %feature% and end with a concrete reason to buy today. Warm and specific, no superlatives, no exclamation marks. Vary the wording densely, but never let one word appear twice within a sentence: do not define two variables that draw from the same list of synonyms, and keep any two slots that share options far apart."
            },
            {
              "id": "pool-v-product",
              "name": "product",
              "type": "string",
              "value": "Trail Runner 3"
            },
            {
              "id": "pool-v-brand",
              "name": "brand",
              "type": "string",
              "value": "Brightline Gear"
            },
            {
              "id": "pool-v-audience",
              "name": "audience",
              "type": "string",
              "value": "weekend hikers"
            },
            {
              "id": "pool-v-feature",
              "name": "feature",
              "type": "string",
              "value": "a 240 g upper that dries overnight"
            }
          ]
        }
      },
