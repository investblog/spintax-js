      "typeVersion": 1,
      "position": [
        1980,
        460
      ]
    },
    {
      "parameters": {
        "operation": "uniqueness",
        "textField": "rendered",
        "dedupJaccard": 0.6,
        "locale": "en",
        "uniquenessOptions": {
          "footprintMax": 1,
          "minPoolForFootprint": 5,
          "macros": "={{ [$('Your brief and product').first().json.product, $('Your brief and product').first().json.brand, $('Your brief and product').first().json.audience, $('Your brief and product').first().json.feature].join('\\n') }}"
        }
